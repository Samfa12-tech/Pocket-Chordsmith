extends SceneTree
const Conductor = preload("res://addons/pocket_chordsmith/runtime/pocket_chordsmith_conductor.gd")
const Profile = preload("res://addons/pocket_chordsmith/resources/pcs_playback_profile.gd")
const Chart = preload("res://addons/pocket_chordsmith/resources/pcs_chart_resource.gd")
var frame_gaps: Array[float] = []
var measuring = false
var previous_us = 0
var label: Label
var sfx: AudioStreamPlayer
var sfx_count = 0
var phase = 0
func _init():
	_run.call_deferred()
func _process(_delta):
	var now = Time.get_ticks_usec()
	if measuring and previous_us > 0:
		frame_gaps.append(float(now-previous_us)/1000.0)
	previous_us=now
	if label != null:
		label.position.x=24+sin(float(now)/1000000.0)*12
		if measuring and phase == 1 and Engine.get_process_frames()%8 == 0:
			sfx.play()
			sfx_count+=1
	return false
func _run():
	root.size=Vector2i(800,480)
	label=Label.new();label.position=Vector2(24,35);label.add_theme_font_size_override("font_size",20);root.add_child(label)
	label.text="Pocket Audio runtime budget\nPreparing generated 8 x 60-second stem fixture.\nCold OS cache is not asserted. No listening claim."
	var profile=Profile.new();profile.sample_preview_prewarm_on_ready=false;profile.sample_preview_enabled=false;profile.preserve_prepared_wav_endings=true
	var maps=[{},{}]
	var names=["guitar","bass","chords","melody"]
	for index in range(8): maps[index/4][names[index%4]]="res://long-stem-%s.wav"%index
	profile.section_stem_sets={"A":maps[0],"B":maps[1]};profile.stem_paths=maps[0];profile.prepared_playback_scope="arrangement";profile.use_audio_stream_synchronized=false
	var music=Conductor.new();music.playback_profile=profile;music.chart=Chart.new();music.chart.bpm=120;music.chart.arrangement.assign(["A"]);music.chart.arrangement_positions.append({"id":"A","arrangement_index":0,"start_tick":0,"length_ticks":3840,"bars":2});root.add_child(music)
	await create_timer(0.2).timeout
	measuring=true;frame_gaps.clear();previous_us=Time.get_ticks_usec()
	var before=Time.get_ticks_usec();var cold=await music.prewarm_sections_async(["A","B"]);var cold_ms=float(Time.get_ticks_usec()-before)/1000.0
	await process_frame;var cold_gaps=frame_gaps.duplicate();measuring=false
	var no_autoplay_after_prewarm=not music.is_playing()
	var resident_bytes=0;var streams={}
	for value in music._audio_stream_cache.values():
		if value is AudioStreamWAV and not streams.has(value.get_instance_id()): streams[value.get_instance_id()]=true;resident_bytes+=value.data.size()
	var warm_calls=[]
	for i in range(20):
		before=Time.get_ticks_usec();music.play();warm_calls.append(float(Time.get_ticks_usec()-before)/1000.0);music.stop()
	AudioServer.add_bus();var bus=AudioServer.bus_count-1;AudioServer.set_bus_name(bus,"Budget_SFX")
	var capture=AudioEffectCapture.new();capture.buffer_length=5;AudioServer.add_bus_effect(bus,capture)
	sfx=AudioStreamPlayer.new();sfx.bus="Budget_SFX";sfx.stream=load("res://sfx.wav");sfx.volume_db=-15;root.add_child(sfx)
	label.text="Pocket Audio runtime budget\nWarm music + periodic game SFX + moving UI.\nFrame timing and SFX bus PCM are measured.\nNo installed-app/device-consumed/listening claim."
	phase=0;measuring=true;frame_gaps.clear();previous_us=Time.get_ticks_usec();await create_timer(3).timeout;var baseline_gaps=frame_gaps.duplicate();measuring=false
	phase=0;measuring=true;frame_gaps.clear();previous_us=Time.get_ticks_usec();music.play();await create_timer(3).timeout;music.stop();var music_gaps=frame_gaps.duplicate();measuring=false
	capture.clear_buffer();phase=1;measuring=true;frame_gaps.clear();previous_us=Time.get_ticks_usec();music.play();await create_timer(3).timeout;music.stop();measuring=false
	var frames=capture.get_buffer(capture.get_frames_available());var sfx_peak=0.0
	for frame in frames: sfx_peak=max(sfx_peak,abs(frame.x),abs(frame.y))
	if DisplayServer.get_name()!="headless":
		await RenderingServer.frame_post_draw;root.get_texture().get_image().save_png("res://runtime-budget.png")
	var report={"test":"runtime-audio-budget","engine":Engine.get_version_info().get("string",""),"driver":AudioServer.get_driver_name(),"fixture":"8 unique PCM16 stereo 60-second 48 kHz assets, generated by repeating retained native-derived output; first conductor load, OS cache not flushed", "cold":cold,"cold_elapsed_ms":cold_ms,"cold_frame_gaps_ms":cold_gaps,"resident_pcm_bytes":resident_bytes,"resident_streams":streams.size(),"warm_play_ms":warm_calls,"baseline_frame_gaps_ms":baseline_gaps,"music_frame_gaps_ms":music_gaps,"game_frame_gaps_ms":frame_gaps,"game_sfx_requests":sfx_count,"game_sfx_captured_frames":frames.size(),"game_sfx_peak":sfx_peak,"static_memory_bytes":OS.get_static_memory_usage(),"no_autoplay_after_prewarm":no_autoplay_after_prewarm}
	var file=FileAccess.open("res://runtime-budget.json",FileAccess.WRITE);file.store_string(JSON.stringify(report));file.close();print(JSON.stringify(report))
	# The synthetic SFX can still be playing when its measurement window ends.
	# Release its playback before tearing down its capture bus or quitting.
	sfx.stop()
	sfx.stream = null
	sfx.queue_free()
	sfx = null
	music.queue_free()
	await process_frame
	await process_frame
	AudioServer.remove_bus_effect(bus,0)
	AudioServer.remove_bus(bus)
	quit(0 if cold.ok and sfx_peak>0.001 and sfx_count>0 else 1)



