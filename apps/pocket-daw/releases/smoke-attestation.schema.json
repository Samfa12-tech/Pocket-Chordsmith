{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Samfa12-tech/Pocket-Chordsmith/apps/pocket-daw/releases/smoke-attestation.schema.json",
  "title": "Pocket DAW exact-artifact smoke attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "commit",
    "installerFile",
    "installerSha256",
    "audioCaptureEvidence",
    "testedAt",
    "result",
    "machine",
    "checks",
    "knownFailures"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "installerFile": {
      "type": "string",
      "minLength": 1
    },
    "installerSha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "audioCaptureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fingerprint"],
      "properties": {
        "mode": {
          "enum": ["fresh-audible", "manual-fresh-audible", "baseline-reuse"]
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "algorithm", "value", "inputs"],
          "properties": {
            "schema": { "const": "pocket-daw-native-pcm-capture-v2" },
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "sha256"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
                }
              }
            }
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attestationFile", "attestationSha256", "installerFile", "installerSha256"],
          "properties": {
            "attestationFile": { "type": "string", "minLength": 1 },
            "attestationSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "installerFile": { "type": "string", "minLength": 1 },
            "installerSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        "manual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceFile", "evidenceSha256"],
          "properties": {
            "evidenceFile": { "type": "string", "minLength": 1 },
            "evidenceSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        },
        "companion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summaryFile", "summarySha256"],
          "properties": {
            "summaryFile": { "type": "string", "minLength": 1 },
            "summarySha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "baseline-reuse" } } },
          "then": { "required": ["baseline"] },
          "else": { "not": { "required": ["baseline"] } }
        },
        {
          "if": { "properties": { "mode": { "const": "manual-fresh-audible" } } },
          "then": { "required": ["manual", "companion"] },
          "else": {
            "allOf": [
              { "not": { "required": ["manual"] } },
              { "not": { "required": ["companion"] } }
            ]
          }
        }
      ]
    },
    "testedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "result": {
      "const": "pass"
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowsVersion",
        "architecture",
        "audioInput",
        "audioOutput"
      ],
      "properties": {
        "windowsVersion": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "audioInput": {
          "type": "string",
          "minLength": 1
        },
        "audioOutput": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "id",
            "result",
            "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "partial"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "result"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "const": "pass"
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "details": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "knownFailures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
