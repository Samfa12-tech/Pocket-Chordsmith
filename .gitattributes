* text=auto eol=lf

*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.gd text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.tres text eol=lf
*.tscn text eol=lf

*.png binary
*.ico binary
*.zip binary
*.wav binary
*.mid binary
*.midi binary

# Preserve the pinned upstream VST3 SDK subset byte-for-byte. Its source files
# intentionally retain upstream whitespace covered by SOURCE_LOCK.json.
apps/pocket-daw/src-tauri/third_party/vst3sdk/** -text whitespace=-trailing-space,-blank-at-eof,-space-before-tab

# Unsupported runnable snapshots are available in the repository history but do
# not belong in generated source archives or current release payloads.
apps/archive/unsupported-runnable-builds/** export-ignore
